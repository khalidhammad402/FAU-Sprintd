# Backend REST base. Default: same origin as the page (/api/v1), which pnpm dev and pnpm preview forward to
# the backend at DH_BACKEND (default http://127.0.0.1:8000). The WebSocket base is derived from it.
# VITE_API_BASE=http://localhost:8000/api/v1
# VITE_WS_BASE=ws://localhost:8000/api/v1/ws
# live = real backend, mock = MSW fixtures + replayed WebSocket messages, no backend needed
VITE_DEMO_MODE=live
